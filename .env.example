# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=optics_db

# Login tokens — long random strings
JWT_SECRET=
USER_JWT_SECRET=

# Legacy admin login (optional)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# AI assistant
ANTHROPIC_API_KEY=

# Email (Resend) — leave RESEND_API_KEY empty to print emails in the terminal instead
RESEND_API_KEY=
EMAIL_FROM=Optician's Desk <noreply@opticiansdesk.co.nz>

# Public address of the site, used for links in emails
APP_URL=http://localhost:3000

# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
# Set to production when live (makes login cookies HTTPS-only)
NODE_ENV=development
# Set to 1 when hosted behind a proxy (Render, Railway, Fly etc.) so rate limits see real visitor IPs
TRUST_PROXY=

# Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=optics_db

# Login tokens — long random strings
JWT_SECRET=
USER_JWT_SECRET=

# Legacy admin login (optional)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# AI assistant
ANTHROPIC_API_KEY=

# Email (Resend) — leave RESEND_API_KEY empty to print emails in the terminal instead
RESEND_API_KEY=
EMAIL_FROM=Optician's Desk <noreply@opticiansdesk.com>

# Public address of the site, used for links in emails
APP_URL=http://localhost:3000
